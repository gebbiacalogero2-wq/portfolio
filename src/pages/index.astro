---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import exifr from 'exifr';
import fs from 'node:fs';
import path from 'node:path';

// Importazione delle foto
import foto1 from '../assets/IMG_0058.JPG';
import foto2 from '../assets/IMG_1886.JPG';
import foto3 from '../assets/IMG_8834.JPG';

const listaFoto = [
  { src: foto1, fileName: 'IMG_0058.JPG', title: "Natura", category: "2025 — Nilo, Egitto", alt: "Fotografia di Calogero Gebbia" },
  { src: foto2, fileName: 'IMG_1886.JPG', title: "Arte", category: "2025 — Moulin Rouge, Parigi - Francia", alt: "Fotografia di Calogero Gebbia" },
  { src: foto3, fileName: 'IMG_8834.JPG', title: "Colori", category: "2024 — Porto, Portogallo", alt: "Fotografia di Calogero Gebbia" }
];

// Estrazione EXIF direttamente dal buffer dei file originali
const fotografie = await Promise.all(
  listaFoto.map(async (foto) => {
    let exifData = null;
    try {
      const filePath = path.join(process.cwd(), 'src/assets', foto.fileName);
      const fileBuffer = fs.readFileSync(filePath);
      const data = await exifr.parse(fileBuffer, ['Make', 'Model', 'FocalLength', 'FNumber', 'ExposureTime', 'ISO']);
      
      if (data) {
        exifData = {
          camera: data.Model ? `${data.Make || ''} ${data.Model}`.trim() : null,
          focal: data.FocalLength ? `${data.FocalLength}mm` : null,
          aperture: data.FNumber ? `f/${data.FNumber}` : null,
          shutter: data.ExposureTime ? (data.ExposureTime < 1 ? `1/${Math.round(1 / data.ExposureTime)}s` : `${data.ExposureTime}s`) : null,
          iso: data.ISO ? `ISO ${data.ISO}` : null
        };
      }
    } catch (e) {
      exifData = null;
    }
    return { ...foto, exif: exifData };
  })
);
---

<BaseLayout title="Calogero Gebbia | Portfolio Fotografico">
  <section class="space-y-6">
    <div class="flex justify-between items-end pb-4 border-b border-neutral-900">
      <h1 class="text-2xl font-light tracking-wide text-neutral-200">Selezioni Fotografiche</h1>
      <span class="text-xs text-neutral-500 uppercase tracking-widest font-mono">Portfolio</span>
    </div>

    <!-- Griglia Fotografica -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {fotografie.map((foto, index) => (
        <div 
          class="group relative aspect-[4/5] bg-neutral-900 rounded-sm overflow-hidden border border-neutral-800/60 cursor-pointer photo-card"
          data-index={index}
        >
          <Image 
            src={foto.src} 
            alt={foto.alt}
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-6 flex flex-col justify-end">
            <span class="text-xs font-mono text-neutral-400">{foto.category}</span>
            <h2 class="text-sm font-medium text-white tracking-wide mt-1">{foto.title}</h2>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Modal / Lightbox a Schermo Intero -->
  <dialog id="photo-modal" class="bg-transparent p-0 backdrop:bg-black/90 backdrop:backdrop-blur-md max-w-none max-h-none w-full h-full fixed inset-0 z-50 border-0 outline-none hidden flex-col justify-between">
    <div class="p-6 flex justify-between items-center text-white w-full">
      <div id="modal-header">
        <h3 id="modal-title" class="text-lg font-light tracking-wide"></h3>
        <p id="modal-category" class="text-xs font-mono text-neutral-400"></p>
      </div>
      <button id="close-modal" class="text-neutral-400 hover:text-white text-2xl font-mono p-2">&times;</button>
    </div>

    <div class="flex-grow flex items-center justify-center p-4 min-h-0">
      <img id="modal-img" class="max-h-full max-w-full object-contain rounded-sm" src="" alt="" />
    </div>

    <!-- Dettagli EXIF -->
    <div class="p-6 text-center text-xs font-mono text-neutral-400 border-t border-neutral-900 bg-black/40">
      <p id="modal-exif">Caricamento parametri di scatto...</p>
    </div>
  </dialog>

  <script is:inline define:vars={{ fotografie }}>
    const modal = document.getElementById('photo-modal');
    const modalImg = document.getElementById('modal-img');
    const modalTitle = document.getElementById('modal-title');
    const modalCategory = document.getElementById('modal-category');
    const modalExif = document.getElementById('modal-exif');
    const closeBtn = document.getElementById('close-modal');

    document.querySelectorAll('.photo-card').forEach(card => {
      card.addEventListener('click', () => {
        const index = card.getAttribute('data-index');
        const item = fotografie[index];

        modalImg.src = item.src.src;
        modalTitle.textContent = item.title;
        modalCategory.textContent = item.category;

        if (item.exif) {
          const details = [item.exif.camera, item.exif.focal, item.exif.aperture, item.exif.shutter, item.exif.iso].filter(Boolean);
          modalExif.textContent = details.length ? details.join('  •  ') : 'Dati EXIF non disponibili';
        } else {
          modalExif.textContent = 'Dati EXIF non disponibili';
        }

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.showModal();
      });
    });

    const closeModal = () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.close();
    };

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  </script>
</BaseLayout>