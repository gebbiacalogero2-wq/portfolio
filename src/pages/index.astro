---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Calogero Gebbia | Fotografia">
  <section class="space-y-6">
    <div class="flex justify-between items-end pb-4">
      <h1 class="text-2xl font-light tracking-wide text-neutral-200">Selezioni Fotografiche</h1>
      <span class="text-xs text-neutral-500 uppercase tracking-widest font-mono">Portfolio</span>
    </div>

    <!-- Griglia Fotografica Responsive -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Placeholder Foto 1 -->
      <div class="group relative aspect-[4/5] bg-neutral-900 rounded-sm overflow-hidden border border-neutral-800/60 cursor-pointer">
        <div class="absolute inset-0 flex items-center justify-center text-neutral-700 font-mono text-sm group-hover:text-neutral-500 transition-colors">
          [ Immagine 01 ]
        </div>
        <!-- Sovrapposizione info al passaggio del mouse -->
        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-6 flex flex-col justify-end">
          <span class="text-xs font-mono text-neutral-400">2026 — Serie Progetto</span>
          <h2 class="text-sm font-medium text-white">Titolo Scatto / Progetto</h2>
        </div>
      </div>

      <!-- Placeholder Foto 2 -->
      <div class="group relative aspect-[4/5] bg-neutral-900 rounded-sm overflow-hidden border border-neutral-800/60 cursor-pointer">
        <div class="absolute inset-0 flex items-center justify-center text-neutral-700 font-mono text-sm group-hover:text-neutral-500 transition-colors">
          [ Immagine 02 ]
        </div>
        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-6 flex flex-col justify-end">
          <span class="text-xs font-mono text-neutral-400">2026 — Architettura</span>
          <h2 class="text-sm font-medium text-white">Luce e Ombra</h2>
        </div>
      </div>

      <!-- Placeholder Foto 3 -->
      <div class="group relative aspect-[4/5] bg-neutral-900 rounded-sm overflow-hidden border border-neutral-800/60 cursor-pointer">
        <div class="absolute inset-0 flex items-center justify-center text-neutral-700 font-mono text-sm group-hover:text-neutral-500 transition-colors">
          [ Immagine 03 ]
        </div>
        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-6 flex flex-col justify-end">
          <span class="text-xs font-mono text-neutral-400">2026 — Paesaggio</span>
          <h2 class="text-sm font-medium text-white">Silenzi</h2>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>