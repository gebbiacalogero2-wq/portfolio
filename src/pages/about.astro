---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Bio & Contatti | Calogero Gebbia">
  <div class="max-w-2xl space-y-8 py-4">
    <h1 class="text-3xl font-light tracking-wide text-neutral-100">Chi Sono</h1>
    
    <div class="space-y-4 text-neutral-300 leading-relaxed font-light">
      <p>
        ERP Specialist con una profonda passione per la fotografia. Esploro il mondo attraverso lo scatto, focalizzandomi su composizione, luce e narrazione visiva.
      </p>
      <p class="text-neutral-400 text-sm">
        La mia ricerca fotografica si concentra sulla geometria degli spazi, i contrasti della luce naturale e la documentazione visiva.
      </p>
    </div>

    <div class="pt-8 border-t border-neutral-800 space-y-4">
      <h2 class="text-sm uppercase tracking-widest text-neutral-400 font-mono">Contatti</h2>
      <ul class="space-y-2 text-sm">
        <li>
          <span class="text-neutral-500 w-20 inline-block">Email:</span>
          <a href="mailto:info@calogerogebbia.it" class="text-neutral-200 hover:text-white underline underline-offset-4">info@calogerogebbia.it</a>
        </li>
        <li>
          <span class="text-neutral-500 w-20 inline-block">Location:</span>
          <span class="text-neutral-300">Italia</span>
        </li>
      </ul>
    </div>
  </div>
</BaseLayout>