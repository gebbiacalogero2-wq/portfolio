---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-950 text-neutral-100 min-h-screen font-sans antialiased flex flex-col">
    <!-- Header / Navigazione -->
    <header class="max-w-6xl w-full mx-auto px-6 py-8 flex justify-between items-center border-b border-neutral-800">
      <a href="/" class="text-sm font-medium tracking-widest uppercase hover:text-neutral-400 transition-colors">
        Calogero Gebbia
      </a>
      <nav class="flex gap-6 text-sm tracking-wide">
        <a href="/" class="hover:text-white text-neutral-400 transition-colors">Galleria</a>
        <a href="/about" class="hover:text-white text-neutral-400 transition-colors">Bio & Contatti</a>
      </nav>
    </header>

    <!-- Contenuto dinamico delle pagine -->
    <main class="max-w-6xl w-full mx-auto px-6 py-12 flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="max-w-6xl w-full mx-auto px-6 py-8 border-t border-neutral-900 text-xs text-neutral-600 flex justify-between items-center">
      <p>&copy; {new Date().getFullYear()} Calogero Gebbia. Tutti i diritti riservati.</p>
      <p class="font-mono">Astro + Vercel</p>
    </footer>
  </body>
</html>
